# ====== REQUIRED ======
BOT_TOKEN=123456:ABC-your-telegram-bot-token
OWNER_ID=123456789

# ====== OPTIONAL ======
# Force-join channel username (without @). Leave blank to disable.
FORCE_JOIN_CHANNEL=
# Public URL of this service (used in /start when deployed). Optional.
PUBLIC_URL=
# Port for health-check web server (Render sets PORT automatically)
PORT=10000
# SQLite path
DB_PATH=bot.db

# Optional MongoDB persistence (mirrors owner settings/providers/users/groups
# so they survive re-deploys). Leave blank to run SQLite-only.
MONGODB_URI=
MONGODB_DB=xenex_bot

# Optional: path to an exported YouTube cookies file for restricted/bot-check links.
# Leave blank to use the repo-level youtube_cookies.txt if present.
YT_COOKIES_FILE=
